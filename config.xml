<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://jbrands.liontv.premiumv1" version="1.0.0">
    <access origin="*" subdomains="true"></access>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <tizen:application id="JBrandsEmu.LionTV" package="JBrandsEmu" required_version="4.0"/>
    <tizen:category name="http://tizen.org/category/video"/>
    <content src="index.html"/>
    
    <tizen:content-security-policy>
        default-src *; 
        script-src 'self' 'unsafe-inline' 'unsafe-eval' *; 
        style-src 'self' 'unsafe-inline' *; 
        img-src * 'self' data: blob:; 
        media-src * 'self' blob:; 
        connect-src *;
    </tizen:content-security-policy>
    
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <feature name="http://tizen.org/feature/network.internet"/>
    <icon src="assets/logo/lion1_small.png"/>
    <tizen:metadata key="http://tizen.org/metadata/prefer_maximizing_application" value="true"/>
    <name>LionTV</name>
    
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/network.public"/>
    <tizen:privilege name="http://tizen.org/privilege/download"/>
    <tizen:privilege name="http://tizen.org/privilege/avplay"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/> 
    <tizen:privilege name="http://tizen.org/privilege/tv.window"/>
    <tizen:privilege name="http://tizen.org/privilege/volume.set"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.read"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.write"/>
    <tizen:profile name="tv"/>
</widget>